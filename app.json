{
  "expo": {
    "name": "JARVIS Mobile",
    "slug": "jarvis-mobile",
    "scheme": "jarvismobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jarvis.mobile"
    },
    "android": {
      "package": "com.jarvis.mobile"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
